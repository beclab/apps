FROM docker.io/qemux/qemu-arm:7.50@sha256:bf44e4b80d49bcafc7945cabcd54ddce1410c32db8ab76c5ebc609da6ee0d364
USER root
ARG TARGETARCH
ENV DEBIAN_FRONTEND=noninteractive
RUN test "$TARGETARCH" = arm64 && apt-get -o Acquire::Retries=3 update && \
    apt-get -o Acquire::Retries=3 install -y --no-install-recommends openssh-client && \
    rm -rf /var/lib/apt/lists/*
RUN groupadd -g 1000 olares-vm && useradd -u 1000 -g 1000 -M -d /tmp -s /usr/sbin/nologin olares-vm && \
    test -s /usr/share/AAVMF/AAVMF_CODE.fd && test -s /usr/share/AAVMF/AAVMF_VARS.fd && \
    test -s /usr/share/novnc/vnc.html
USER 1000:1000
EXPOSE 22 2222 8006
